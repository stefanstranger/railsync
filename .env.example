# Environment variables for RailSync
# Copy this file to .env and fill in your values

# Träwelling OAuth2 credentials
# Register your application at: https://traewelling.de/settings/applications
TRAEWELLING_CLIENT_ID=your_client_id_here
TRAEWELLING_CLIENT_SECRET=your_client_secret_here
TRAEWELLING_REDIRECT_URI=http://localhost:8000/callback

# Träwelling API base URL (usually don't need to change)
TRAEWELLING_API_BASE=https://traewelling.de/api/v1

# Debug mode (set to true for verbose logging)
RAILSYNC_DEBUG=false

# Default visibility for check-ins
# 0 = public, 1 = unlisted, 2 = followers only, 3 = private
RAILSYNC_DEFAULT_VISIBILITY=0

# Default business type for check-ins
# 0 = private, 1 = business, 2 = commute
RAILSYNC_DEFAULT_BUSINESS_TYPE=0
